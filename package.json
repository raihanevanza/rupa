{
  "name": "rupa",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "npm run build -w @rupa-ui/tokens && npm run build -w @rupa-ui/react",
    "build:docs": "npm run build && npm run build -w @rupa-ui/docs",
    "dev": "npm run build -w @rupa-ui/tokens && npm run dev -w @rupa-ui/docs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/visual",
    "lint": "eslint . && npm run lint:css -w @rupa-ui/react",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:visual": "playwright test -c tests/visual",
    "test:visual:docker": "sh tests/visual/docker.sh",
    "test:visual:update": "sh tests/visual/docker.sh --update-snapshots",
    "check:package": "npm run check:package -w @rupa-ui/tokens && npm run check:package -w @rupa-ui/react",
    "size": "npm run size -w @rupa-ui/react",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
