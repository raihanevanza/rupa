{
  "name": "@rupa-ui/react-native",
  "version": "0.1.2",
  "description": "React Native components (Android and iOS) for the Rupa design system, themed by @rupa-ui/tokens.",
  "license": "MIT",
  "homepage": "https://raihan-evanza-rupa.vercel.app/?path=/story/react-native-overview--screen",
  "bugs": {
    "url": "https://github.com/raihanevanza/rupa/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raihanevanza/rupa.git",
    "directory": "packages/react-native"
  },
  "keywords": [
    "react-native",
    "android",
    "ios",
    "design-system",
    "components",
    "accessibility",
    "dark-mode"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-native": ">=0.76"
  },
  "dependencies": {
    "@rupa-ui/tokens": "0.2.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "test-renderer": "^1.3.1"
  }
}
