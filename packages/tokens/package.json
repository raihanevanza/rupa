{
  "name": "@rupa-ui/tokens",
  "version": "0.2.1",
  "description": "Design tokens for Rupa: multi-brand colors with light and dark modes, typography, spacing, and chart palettes, for CSS, Tailwind, JS, and React Native.",
  "license": "MIT",
  "homepage": "https://raihan-evanza-rupa.vercel.app/?path=/story/foundations-colors--semantic",
  "bugs": {
    "url": "https://github.com/raihanevanza/rupa/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raihanevanza/rupa.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "tailwind",
    "react-native",
    "dark-mode"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./css": "./dist/css/tokens.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./tailwind/v4.css": "./dist/tailwind/v4.css",
    "./tailwind/preset": {
      "types": "./dist/tailwind/preset.d.ts",
      "default": "./dist/tailwind/preset.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node scripts/check-contrast.ts && node scripts/check-chart.ts",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints css css/tokens.css tailwind/v4.css tokens.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "style-dictionary": "^5.7.0",
    "typescript": "^6.0.3"
  }
}
