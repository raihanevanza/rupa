{
  "space": {
    "$type": "dimension",
    "0": { "$value": "0rem" },
    "0-5": { "$value": "0.125rem" },
    "1": { "$value": "0.25rem" },
    "1-5": { "$value": "0.375rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "0.375rem" },
    "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.625rem" },
    "xl": { "$value": "0.875rem" },
    "2xl": { "$value": "1.125rem" },
    "full": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "control-sm": { "$value": "2rem" },
    "control-md": { "$value": "2.5rem" },
    "control-lg": { "$value": "3rem" },
    "touch-target": { "$value": "2.75rem", "$description": "44 px minimum on coarse pointers" },
    "focus-ring": { "$value": "2px" },
    "focus-offset": { "$value": "2px" }
  },
  "z": {
    "$type": "number",
    "dropdown": { "$value": 1000 },
    "sticky": { "$value": 1100 },
    "overlay": { "$value": 1300 },
    "dialog": { "$value": 1400 },
    "toast": { "$value": 1500 },
    "tooltip": { "$value": 1600 }
  }
}
