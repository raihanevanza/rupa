{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Plus Jakarta Sans Variable",
          "Plus Jakarta Sans",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "snug": { "$value": 1.4 },
      "normal": { "$value": 1.55 }
    }
  }
}
